PORT=3000
NODE_ENV=production

# Security
# JWT_SECRET 生产环境必须设置，且不短于 32 个字符，否则服务拒绝启动。
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string
# CORS_ORIGIN 生产环境不允许为空或 *，填明确的来源，多个用逗号分隔
CORS_ORIGIN=https://your-domain.example

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# MySQL
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=mysql-server
MYSQL_PORT=3306
MYSQL_USER=equiptrack_user
MYSQL_PASSWORD=change-this-db-password
MYSQL_DATABASE=EquipTrack
# 自动 DDL 会在实体变动时直接改表结构（可能 DROP 列丢数据），
# 生产环境一旦设为 true 服务会拒绝启动
TYPEORM_SYNCHRONIZE=false
DB_SYNCHRONIZE=false

# Database startup and readiness checks
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_DELAY_MS=2000
DB_HEALTHCHECK_TIMEOUT_MS=3000
DB_WATCHDOG_INTERVAL_MS=30000
DB_WATCHDOG_FAILURE_THRESHOLD=3

# Firebase Configuration (Choose Option 1 OR Option 2)

# Option 1: Path to service account file (Recommended for Docker with volume mount)
# Ensure you put your serviceAccountKey.json in the ./config folder on the host
GOOGLE_APPLICATION_CREDENTIALS=/app/config/serviceAccountKey.json

# Option 2: JSON Content string (Alternative if you don't want to mount files)
# FIREBASE_CREDENTIALS='{"type": "service_account", ...}'

# 初始超级管理员（只在数据库里一个用户都没有时生效）
# 空库无法通过注册接口创建第一个账号：注册要求邀请码属于某位在职管理者。
# 填好下面两项后启动服务即会自动创建；只要库里已有任何账号，这两项一律被忽略，
# 不会覆盖或重置已有管理员的密码。
# 创建完成后建议登录改密，并把 INITIAL_ADMIN_PASSWORD 从本文件删掉。
INITIAL_ADMIN_CONTACT=
INITIAL_ADMIN_PASSWORD=

# 可选
# INITIAL_ADMIN_NAME=超级管理员
# INITIAL_ADMIN_DEPARTMENT=总部
# INITIAL_ADMIN_INVITATION_CODE=
